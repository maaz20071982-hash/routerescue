ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
ADMIN_API_KEY=routerescue-admin-sprint2

# Google Cloud Firestore (Backend-Only Credentials)
GOOGLE_APPLICATION_CREDENTIALS=
FIRESTORE_PROJECT_ID=
FIRESTORE_COLLECTION=incidents

# Sprint 3: Evidence-Aware Verification & Freshness Thresholds
FRESHNESS_STALE_HOURS=6.0
DUPLICATE_PROXIMITY_METERS=500.0
DUPLICATE_TIME_WINDOW_HOURS=4.0
DUPLICATE_TEXT_SIMILARITY_THRESHOLD=0.40
CONFLICT_PROXIMITY_METERS=1000.0

# Sprint 5: External Ingestion Layer Configuration
# NOAA / National Weather Service Alerts (Public Government API)
NWS_API_ENABLED=true
NWS_USER_AGENT=RouteRescue-Ingestion/1.0 (emergency-coord-eval@routerescue.local)
NWS_ALERTS_ENDPOINT=https://api.weather.gov/alerts/active?status=actual&message_type=alert,update&limit=25

# Twitter / X API v2 (Authorized Developer Bearer Token)
# Leave empty to keep integration safely DISABLED with setup documentation
TWITTER_API_ENABLED=false
TWITTER_BEARER_TOKEN=

# Reddit OAuth API (Authorized Developer Script App)
# Leave empty to keep integration safely DISABLED with setup documentation
REDDIT_API_ENABLED=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Resiliency, Timeouts & Retries
INGESTION_REQUEST_TIMEOUT_SECONDS=8.0
INGESTION_MAX_RETRIES=2
